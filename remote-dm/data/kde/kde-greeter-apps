#!/bin/sh
# Started by the greeter's KWin (kde-greeter), so it has WAYLAND_DISPLAY.

# Mutter's screencast and remote desktop interfaces for gnome-remote-desktop, on top of KWin.
kwin-mutter-bridge &
for _ in $(seq 50); do
  busctl --user status org.gnome.Mutter.RemoteDesktop >/dev/null 2>&1 && break
  sleep 0.1
done

# gnome-remote-desktop's handover daemon takes over the RDP connection. It's the systemd user
# service grd ships, restarted if it crashes.
systemctl --user start gnome-remote-desktop-handover.service

# Stands in for gnome-session's Logout, which grd calls to end the greeter when the RDP session
# ends.
remote-dm session-manager &

# The login screen: KDE's own (plasma-login-manager's, remote-dm speaks its protocol on
# SDDM_SOCKET) if it's installed, otherwise regreet (or any greetd greeter, on GREETD_SOCK).
# REMOTE_DM_GREETER picks another command. Restarted if it crashes, so the remote user isn't left
# with an empty screen. regreet exits successfully after a login and stays gone; KDE's keeps
# running until remote-dm ends the greeter session.
greeter=${REMOTE_DM_GREETER:-}
if [ -z "$greeter" ]; then
  if [ -x /usr/lib/plasma-login-greeter ]; then
    greeter=/usr/lib/plasma-login-greeter
  else
    greeter=regreet
  fi
fi
if [ "$greeter" = /usr/lib/plasma-login-greeter ] && [ -x /usr/bin/plasma-login-wallpaper ]; then
  # The greeter's windows are transparent, the wallpaper is its own program.
  plasma-login-wallpaper &
fi
until $greeter; do sleep 1; done
